{
  "name": "mini-cursor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "手写 Agent Loop 学习演示：流式对话 + read_file + 最多 3 步循环",
  "scripts": {
    "start": "tsx src/cli.ts",
    "chat": "tsx src/cli.ts",
    "replay": "tsx src/replay.ts",
    "eval": "tsx src/eval.ts",
    "eval:day9:good": "tsx src/eval.ts --profile good --cases evals/cases-day9.json",
    "eval:day9:sloppy": "tsx src/eval.ts --profile sloppy --cases evals/cases-day9.json",
    "eval:day10:good": "tsx src/eval.ts --profile good --cases evals/cases-day10.json",
    "eval:day10:fewshot": "tsx src/eval.ts --profile fewshot --cases evals/cases-day10.json",
    "eval:day10:sloppy": "tsx src/eval.ts --profile sloppy --cases evals/cases-day10.json",
    "demo:day11": "tsx src/demo_day11.ts",
    "demo:day12": "tsx src/demo_day12.ts",
    "demo:day13": "tsx src/demo_day13.ts",
    "server": "tsx src/server.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
