# DeepSeek（OpenAI 兼容）
OPENAI_API_KEY=sk-your-deepseek-key
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# Agent 工作区（默认：本目录下的 playground）
# WORKSPACE=./playground

# Prompt 对照：good | sloppy | fewshot（也可用 npm run eval:day10:* 的 --profile）
# PROMPT_PROFILE=good

# 评测题库（也可用 --cases）；推荐直接：npm run eval:day9:good
# EVAL_CASES=evals/cases-day9.json

# Day11 上下文：超预算时对丢弃段做 LLM 摘要（1=开）
# CONTEXT_SUMMARY=1
# 字符预算（演示可调小，如 3500）
# CONTEXT_MAX_CHARS=20000
# 单条 tool 内容上限
# CONTEXT_MAX_TOOL=2500

# Day12 关键事实卡（旁路结构化状态，裁剪后仍钉回上下文）
# TASK_FACTS=1
# 可选：再用 LLM 合并事实（更贵）
# TASK_FACTS_LLM=1

# Day13 长期记忆：新会话注入 memory/user.json（CLI 仍可用「记住：」写入）
# LONG_TERM_MEMORY=1
# MEMORY_FILE=memory/user.json

# Day14 RAG（硅基流动 embedding + DeepSeek 生成）
# RAG=1
# RAG_TOP_K=3
# RAG_DOCS=playground/docs
# RAG_INDEX=memory/rag-index.json
# 有免费额度：https://siliconflow.cn → 创建 API Key
# EMBEDDING_API_KEY=sk-xxx
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_MODEL=BAAI/bge-m3
# 无 key 时自动 EMBEDDING_MODE=local（哈希向量，仅跑通管线）
# EMBEDDING_MODE=local
