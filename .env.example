# DeepSeek（OpenAI 兼容）
OPENAI_API_KEY=sk-your-deepseek-key
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# Agent 工作区（默认：本目录下的 playground）
# WORKSPACE=./playground

# Prompt 对照：good | sloppy | fewshot（也可用 npm run eval:day10:* 的 --profile）
# PROMPT_PROFILE=good

# 评测题库（也可用 --cases）；推荐直接：npm run eval:day9:good
# EVAL_CASES=evals/cases-day9.json
